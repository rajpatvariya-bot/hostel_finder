{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://hostel-finder-88mw.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://hostel-finder-88mw.onrender.com/uploads/:match*"
    },
    {
      "source": "/",
      "destination": "/backend/src/main/resources/static/pages/index.html"
    },
    {
      "source": "/index",
      "destination": "/backend/src/main/resources/static/pages/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/backend/src/main/resources/static/pages/index.html"
    },
    {
      "source": "/css/:match*",
      "destination": "/backend/src/main/resources/static/css/:match*"
    },
    {
      "source": "/js/:match*",
      "destination": "/backend/src/main/resources/static/js/:match*"
    },
    {
      "source": "/img/:match*",
      "destination": "/backend/src/main/resources/static/img/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/backend/src/main/resources/static/assets/:match*"
    },
    {
      "source": "/pages/css/:match*",
      "destination": "/backend/src/main/resources/static/css/:match*"
    },
    {
      "source": "/pages/js/:match*",
      "destination": "/backend/src/main/resources/static/js/:match*"
    },
    {
      "source": "/pages/img/:match*",
      "destination": "/backend/src/main/resources/static/img/:match*"
    },
    {
      "source": "/:page(login|admin-login|admin-dashboard|admin-owners|hostel-details|owner-dashboard|owner-inquiries|owner-register|student-dashboard)",
      "destination": "/backend/src/main/resources/static/pages/:page.html"
    },
    {
      "source": "/:page(login|admin-login|admin-dashboard|admin-owners|hostel-details|owner-dashboard|owner-inquiries|owner-register|student-dashboard).html",
      "destination": "/backend/src/main/resources/static/pages/:page.html"
    },
    {
      "source": "/pages/:page(login|admin-login|admin-dashboard|admin-owners|hostel-details|owner-dashboard|owner-inquiries|owner-register|student-dashboard|index)",
      "destination": "/backend/src/main/resources/static/pages/:page.html"
    },
    {
      "source": "/pages/:page(login|admin-login|admin-dashboard|admin-owners|hostel-details|owner-dashboard|owner-inquiries|owner-register|student-dashboard|index).html",
      "destination": "/backend/src/main/resources/static/pages/:page.html"
    },
    {
      "source": "/pages/:match*",
      "destination": "/backend/src/main/resources/static/pages/:match*"
    }
  ]
}
